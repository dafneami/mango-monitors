class ActionRow(Gtk.Box):
    """Replacement for Adw.ActionRow: title (+ optional subtitle) plus suffix."""

    def __init__(self, title="", subtitle=None):
        super().__init__(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        self.set_margin_top(8)
        self.set_margin_bottom(8)
        self.set_margin_start(12)
        self.set_margin_end(12)

        text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        text_box.set_hexpand(True)
        text_box.set_valign(Gtk.Align.CENTER)

        self.title_label = Gtk.Label(label=title, xalign=0)
        text_box.append(self.title_label)

        self.subtitle_label = None
        if subtitle:
            self.subtitle_label = Gtk.Label(label=subtitle, xalign=0)
            self.subtitle_label.add_css_class("dim-label")
            self.subtitle_label.set_wrap(True)
            text_box.append(self.subtitle_label)

        self.append(text_box)

    def add_suffix(self, widget):
        widget.set_valign(Gtk.Align.CENTER)
        self.append(widget)

    def set_activatable_widget(self, widget):
        # No-op without libadwaita; kept for API symmetry.
        pass


class PrefGroup(Gtk.Box):
    """Replacement for Adw.PreferencesGroup: title + description + row list."""

    def __init__(self, title="", description=None):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.set_margin_top(6)
        self.set_margin_bottom(6)

        self.title_label = Gtk.Label(label=title, xalign=0)
        self.title_label.add_css_class("heading")
        self.title_label.set_margin_start(6)
        self.append(self.title_label)

        self.desc_label = Gtk.Label(label=description or "", xalign=0)
        self.desc_label.add_css_class("dim-label")
        self.desc_label.set_wrap(True)
        self.desc_label.set_margin_start(6)
        self.desc_label.set_margin_end(6)
        self.desc_label.set_visible(bool(description))
        self.append(self.desc_label)

        self.listbox = Gtk.ListBox()
        self.listbox.add_css_class("boxed-list")
        self.listbox.set_selection_mode(Gtk.SelectionMode.NONE)
        self.append(self.listbox)

    def set_title(self, text):
        self.title_label.set_label(text)

    def set_description(self, text):
        self.desc_label.set_label(text or "")
        self.desc_label.set_visible(bool(text))

    def add(self, child):
        row = Gtk.ListBoxRow()
        row.set_child(child)
        row.set_activatable(False)
        row.set_selectable(False)
        self.listbox.append(row)


class ConfirmDialog(Gtk.Window):
    """Replacement for Adw.MessageDialog with two responses."""

    def __init__(self, parent, heading, body):
        super().__init__(transient_for=parent, modal=True)
        self.set_title(heading)
        self.set_default_size(420, -1)
        self.set_resizable(False)

        self._response_handler = None
        self._responded = False

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        box.set_margin_top(24)
        box.set_margin_bottom(24)
        box.set_margin_start(24)
        box.set_margin_end(24)

        h = Gtk.Label(label=heading, xalign=0)
        h.add_css_class("title-3")
        h.set_wrap(True)
        box.append(h)

        self.body_label = Gtk.Label(label=body, xalign=0)
        self.body_label.set_wrap(True)
        box.append(self.body_label)

        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        btn_box.set_halign(Gtk.Align.END)
        btn_box.set_margin_top(8)

        revert_btn = Gtk.Button(label="Revert")
        revert_btn.connect("clicked", lambda *_: self.respond("revert"))

        keep_btn = Gtk.Button(label="Keep Changes")
        keep_btn.add_css_class("suggested-action")
        keep_btn.connect("clicked", lambda *_: self.respond("keep"))

        btn_box.append(revert_btn)
        btn_box.append(keep_btn)
        box.append(btn_box)

        self.set_child(box)
        self.connect("close-request", self._on_close_request)

    def _on_close_request(self, *_):
        if not self._responded:
            self._responded = True
            h = self._response_handler
            if h:
                h("revert")
        return False

    def set_body(self, text):
        self.body_label.set_label(text)

    def connect_response(self, handler):
        self._response_handler = handler

    def respond(self, resp):
        if self._responded:
            return
        self._responded = True
        h = self._response_handler
        if h:
            h(resp)
        self.close()


# ----------------------------------------------------------------------------
# Canvas — draggable monitor arrangement
# ----------------------------------------------------------------------------

class Canvas(Gtk.DrawingArea):
    def __init__(self, app):
        super().__init__()
        self.app = app
        self.set_hexpand(True)
        self.set_vexpand(True)
        self.set_content_width(620)
        self.set_content_height(340)
        self.set_draw_func(self.draw)

        self._scale = 1.0
        self._ox = 0.0
        self._oy = 0.0
        self.drag_target = None
        self.drag_start = None  # (orig_x, orig_y)

        drag = Gtk.GestureDrag()
        drag.connect("drag-begin", self.on_begin)
        drag.connect("drag-update", self.on_update)
        drag.connect("drag-end", self.on_end)
        self.add_controller(drag)

        click = Gtk.GestureClick()
        click.connect("pressed", self.on_click)
        self.add_controller(click)

    # world (layout px) <-> canvas px
    def fit(self, width, height):
        en = [m for m in self.app.monitors if m.enabled]
        if not en:
            self._scale = 1.0
            self._ox = self._oy = 0.0
            return
        maxx = max(m.x + m.logical_size()[0] for m in en)
        maxy = max(m.y + m.logical_size()[1] for m in en)
        maxx = max(maxx, 1)
        maxy = max(maxy, 1)
        pad = 40
        sx = (width - 2 * pad) / maxx
        sy = (height - 2 * pad) / maxy
        self._scale = min(sx, sy, 0.25)
        self._ox = (width - maxx * self._scale) / 2
        self._oy = (height - maxy * self._scale) / 2

    def to_canvas(self, x, y):
        return (self._ox + x * self._scale, self._oy + y * self._scale)

    def to_world(self, cx, cy):
        return ((cx - self._ox) / self._scale, (cy - self._oy) / self._scale)

    def hit(self, cx, cy):
        wx, wy = self.to_world(cx, cy)
        for m in reversed(self.app.monitors):
            if not m.enabled:
                continue
            w, h = m.logical_size()
            if m.x <= wx <= m.x + w and m.y <= wy <= m.y + h:
                return m
        return None

    def draw(self, area, cr, width, height, *_):
        self.fit(width, height)
        cr.set_source_rgb(*CANVAS_BG)
        cr.paint()

        for m in self.app.monitors:
            if not m.enabled:
                continue
            w, h = m.logical_size()
            x, y = self.to_canvas(m.x, m.y)
            cw, chh = w * self._scale, h * self._scale
            selected = (m is self.app.selected)

            cr.rectangle(x + 2, y + 2, cw - 4, chh - 4)
            if selected:
                cr.set_source_rgba(*ACCENT, 0.18)
            else:
                cr.set_source_rgba(0.5, 0.5, 0.55, 0.10)
            cr.fill()

            cr.rectangle(x + 2, y + 2, cw - 4, chh - 4)
            cr.set_line_width(3 if selected else 1.5)
            cr.set_source_rgb(*(ACCENT if selected else ACCENT_DIM))
            cr.stroke()

            self._label(cr, m, x, y, cw, chh)

        # disabled monitors as a little tray at the bottom
        off = [m for m in self.app.monitors if not m.enabled]
        if off:
            tx = 12
            for m in off:
                cr.set_source_rgb(*DISABLED)
                cr.rectangle(tx, height - 26, 90, 18)
                cr.fill()
                self._text(cr, f"{m.name} (off)", tx + 6, height - 22, 9,
                           (1, 1, 1))
                tx += 100

    def _label(self, cr, m, x, y, cw, chh):
        name = m.name
        res = f"{m.width}×{m.height}"
        extra = f"@{m.refresh:g}  ×{m.scale:g}"
        if m.transform:
            extra += "  ⟳"
        self._text(cr, name, x + 10, y + 10, 14, (0.1, 0.12, 0.2), bold=True)
        self._text(cr, res, x + 10, y + 30, 11, (0.25, 0.27, 0.35))
        self._text(cr, extra, x + 10, y + 46, 10, (0.4, 0.42, 0.5))

    def _text(self, cr, text, x, y, size, rgb, bold=False):
        layout = self.create_pango_layout(text)
        desc = Pango.FontDescription()
        desc.set_size(int(size * Pango.SCALE))
        if bold:
            desc.set_weight(Pango.Weight.BOLD)
        layout.set_font_description(desc)
        cr.move_to(x, y)
        cr.set_source_rgb(*rgb)
        from gi.repository import PangoCairo
        PangoCairo.show_layout(cr, layout)

    # --- gestures ---
    def on_click(self, gesture, n, cx, cy):
        m = self.hit(cx, cy)
        if m:
            self.app.select(m)

    def on_begin(self, gesture, sx, sy):
        m = self.hit(sx, sy)
        if m:
            self.drag_target = m
            self.drag_start = (m.x, m.y)
            self.app.select(m)
        else:
            self.drag_target = None

    def on_update(self, gesture, dx, dy):
        if not self.drag_target:
            return
        wx = self.drag_start[0] + dx / self._scale
        wy = self.drag_start[1] + dy / self._scale
        self.drag_target.x = round(wx)
        self.drag_target.y = round(wy)
        self.snap(self.drag_target)
        self.queue_draw()

    def on_end(self, gesture, dx, dy):
        if not self.drag_target:
            return
        normalize(self.app.monitors)
        self.drag_target = None
        self.app.refresh_fields()
        self.queue_draw()

    def snap(self, mon):
        w, h = mon.logical_size()
        others = [o for o in self.app.monitors if o is not mon and o.enabled]
        # candidate x positions (edge-to-edge and aligned edges)
        xs, ys = [0], [0]
        for o in others:
            ow, oh = o.logical_size()
            xs += [o.x + ow, o.x - w, o.x, o.x + ow - w]
            ys += [o.y + oh, o.y - h, o.y, o.y + oh - h]
        for cand in xs:
            if abs(mon.x - cand) <= SNAP:
                mon.x = cand
                break
        for cand in ys:
            if abs(mon.y - cand) <= SNAP:
                mon.y = cand
                break


